rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Videos Collection
    match /videos/{videoId} {
      allow read, write: if true;
    }

    // User Video Permissions (View Limits)
    match /user_video_permissions/{permId} {
      allow read, write: if true;
    }

    // Device Change Requests
    match /device_change_requests/{requestId} {
      allow read, write: if true;
    }

    // Watch Sessions (Analytics Log)
    match /watch_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

